<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.neilmason</groupId>
    <artifactId>connectrpc-spring</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>connectrpc-spring</name>
    <description>Serves the Connect protocol (connectrpc.com) from existing gRPC service definitions, on plain Spring WebFlux</description>
    <url>https://github.com/neilpmas/connectrpc-spring</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Neil Mason</name>
            <email>neilpmas@gmail.com</email>
            <url>https://github.com/neilpmas</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/neilpmas/connectrpc-spring.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/neilpmas/connectrpc-spring.git</developerConnection>
        <url>https://github.com/neilpmas/connectrpc-spring</url>
    </scm>

    <modules>
        <module>connectrpc-spring-core</module>
        <module>connectrpc-spring-dependencies</module>
        <module>connectrpc-spring-docs</module>
        <!-- <module>samples</module> -->
    </modules>

    <properties>
        <!-- Matches Spring Boot's own RUNTIME_JAVA_VERSION baseline (JavaConventions.java
             in the spring-boot build) so published artifacts work for any Boot-compatible
             consumer, not just those on the same JDK this repo happens to build with. -->
        <java.version>17</java.version>

        <!-- GitHub Packages retired (task-connectrpc-spring-boot-starter Phase 8.5): both known
             consumers have migrated to Maven Central, so there's no distributionManagement
             repository left for the default maven-deploy-plugin to target. Skip it rather than
             have `mvn deploy` fail on a missing distributionManagement; the release profile's
             central-publishing-maven-plugin handles the real Central publish itself,
             independent of this. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-framework.version>7.0.9</spring-framework.version>
        <spring-security.version>7.1.0</spring-security.version>
        <grpc.version>1.82.1</grpc.version>
        <protobuf.version>4.35.1</protobuf.version>
        <protobuf-maven-plugin.version>5.1.8</protobuf-maven-plugin.version>

        <!-- Versions verified as a compatible pair from spring-projects/spring-boot's own build
             (gradle.properties: javaFormatVersion / checkstyleToolVersion), not just latest-of-each,
             since spring-javaformat-checkstyle wraps specific Checkstyle APIs that can break across
             major Checkstyle versions. -->
        <spring-javaformat.version>0.0.47</spring-javaformat.version>
        <checkstyle.version>10.12.4</checkstyle.version>

        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>

        <!-- connectrpc-spring-docs (task-connectrpc-spring-boot-starter Phase 6.2): versions
             verified against reference-spring-grpc's real spring-grpc-docs setup, not guessed.
             All confirmed public on Maven Central, unlike some of Spring's own internal-only
             build tooling found in Phase 8. -->
        <antora.maven.plugin.version>1.0.0-alpha.5</antora.maven.plugin.version>
        <io.spring.maven.antora-version>0.0.4</io.spring.maven.antora-version>
        <maven-assembly-plugin.version>3.8.0</maven-assembly-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>${spring-framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-bom</artifactId>
                <version>${spring-security.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-bom</artifactId>
                <version>${protobuf.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Enforces and can auto-apply Spring's own code formatting conventions, matching
                 how spring-projects/spring-grpc and spring-projects/spring-boot both do this.
                 Run `./mvnw spring-javaformat:apply` to auto-format; `validate` (bound below) fails
                 the build if code doesn't already match. -->
            <plugin>
                <groupId>io.spring.javaformat</groupId>
                <artifactId>spring-javaformat-maven-plugin</artifactId>
                <version>${spring-javaformat.version}</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>validate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Spring's shared checkstyle ruleset ships inside the spring-javaformat-checkstyle
                 artifact itself (io/spring/javaformat/checkstyle/checkstyle.xml on its classpath),
                 so no local checkstyle.xml is needed for these base rules. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>io.spring.javaformat</groupId>
                        <artifactId>spring-javaformat-checkstyle</artifactId>
                        <version>${spring-javaformat.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>checkstyle-validation</id>
                        <phase>validate</phase>
                        <configuration>
                            <configLocation>io/spring/javaformat/checkstyle/checkstyle.xml</configLocation>
                            <consoleOutput>true</consoleOutput>
                            <includeTestSourceDirectory>true</includeTestSourceDirectory>
                            <!-- Generated protobuf sources aren't hand-written code; don't lint
                                 them, matching connectrpc-spring-boot's equivalent Gradle
                                 exclusion. Only surfaced by connectrpc-spring-docs' Antora
                                 collector: its `mvnw package -P javadoc` forks a second build of
                                 each module (maven-javadoc-plugin:aggregate needs compiled
                                 sources), and that second pass runs checkstyle after protobuf
                                 test-source generation has already happened, unlike a normal
                                 single build. A glob exclude doesn't work here: checkstyle
                                 matches paths relative to each registered source root, and the
                                 generated directory itself IS the root, so its own name never
                                 appears in the relative path being matched. Restricting the
                                 scanned test source root instead is deterministic. -->
                            <testSourceDirectories>${project.basedir}/src/test/java</testSourceDirectories>
                        </configuration>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Sources/javadoc jars, GPG signing, and the Central Portal upload only run under
         -Prelease, since Central requires them on every deployed artifact, but they'd only
         slow down and add noise to the everyday mvn test/verify loop. Activated by the
         release workflow, not by local dev builds. -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- Non-interactive signing (CI, and this repo's own sandboxed shell
                                 have no tty for gpg's normal pinentry prompt), needed since the
                                 passphrase itself comes from the gpg.passphrase property, never
                                 hardcoded here. -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Aggregates every reactor module's public API into one root-level target/site/apidocs
             site, matching reference-spring-grpc's real root pom.xml exactly. Consumed by
             connectrpc-spring-docs' Antora collector (via `mvnw package -P javadoc -DskipTests`),
             not activated by everyday builds. -->
        <profile>
            <id>javadoc</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <overview>${project.basedir}/connectrpc-spring-docs/src/main/javadoc/overview.html</overview>
                            <detectJavaApiLink>false</detectJavaApiLink>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>generate-aggregate-javadocs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
